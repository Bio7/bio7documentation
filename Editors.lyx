\end_layout

\begin_layout LyX-Code

\end_layout

\begin_layout LyX-Code
    def init(self):
\end_layout

\begin_layout LyX-Code
        self.size(120, 120)
\end_layout

\begin_layout LyX-Code
        self.palette("#ffffff", "#1f3a93")
\end_layout

\begin_layout LyX-Code
        self.cells[:] = self.random_array() < self.density
\end_layout

\begin_layout LyX-Code

\end_layout

\begin_layout LyX-Code
    def step(self):
\end_layout

\begin_layout LyX-Code
        n = self.count_neighbors(1)
\end_layout

\begin_layout LyX-Code
        self.cells = ((n == 3) | ((self.cells == 1) & (n == 2))).astype(int)
\end_layout

\begin_layout LyX-Code
        self.chart("Living cells", self.count(1))
\end_layout

