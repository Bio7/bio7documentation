\family default
, 
\family typewriter
distance3
\family default
, 
\family typewriter
logistic
\family default
, 
\family typewriter
logisticGrowth
\family default
, the statistics 
\family typewriter
sum
\family default
, 
\family typewriter
mean
\family default
, 
\family typewriter
variance
\family default
, 
\family typewriter
sd
\family default
, 
\family typewriter
