\begin_layout Subsubsection
Recording of Plots
\end_layout

\begin_layout Standard
With the class 
\family typewriter
PlotRecorder
\family default
 a dynamic plot can be recorded frame by frame and exported to an HTML page with a player (Play/Pause, a timeline, the speed and a loop) or for Blender as an animation (the visibility of the objects is animated in the timeline of Blender, e.g., to render a film).
\end_layout

\begin_layout Standard
\begin_inset Float table
placement H
alignment document
wide false
sideways false
status open

\begin_layout Plain Layout
\begin_inset listings
lstparams "basicstyle={\rmfamily},language=Java,numbers=left"
inline false
status open

\begin_layout Plain Layout
PlotRecorder recorder = new PlotRecorder().speed(10);
\end_layout

\begin_layout Plain Layout
for (int t = 0; t < 100; t++) {
\end_layout

\begin_layout Plain Layout
    step(); // the model
\end_layout

\begin_layout Plain Layout
    plot.clearLayers().add(Plot3D.scatter(x, y, z)).update();
\end_layout

\begin_layout Plain Layout
    recorder.frame(plot);
\end_layout

\begin_layout Plain Layout
}
\end_layout

\begin_layout Plain Layout
recorder.export("/path/recording.html");
\end_layout

\begin_layout Plain Layout
recorder.exportBlender("/path/recording.glb");
\end_layout

\end_inset


