\begin_layout Subsubsection
Dynamic Plots
\end_layout

\begin_layout Standard
A plot can be updated, e.g., in each step of a simulation: the layers are replaced (
\family typewriter
clearLayers
\family default
, 
\family typewriter
set
\family default
, 
\family typewriter
remove
\family default
, 
\family typewriter
add
\family default
) and the plot is displayed again with 
\family typewriter
update()
\family default
 (without a reset of the view, the rotation and the zoom are kept). Several examples are available in the folder opengl/plotapi/dynamic of the Bio7 Java examples (e.g., a dynamic scatter plot, histogram, violin plot or rose chart).
\end_layout

\begin_layout Standard
\begin_inset Float table
placement H
alignment document
wide false
sideways false
status open

\begin_layout Plain Layout
\begin_inset listings
lstparams "basicstyle={\rmfamily},language=Java,numbers=left"
inline false
status open

\begin_layout Plain Layout
Plot3D plot = new Plot3D().title("Random Walk").xRange(-30, 30).yRange(-30, 30).zRange(-30, 30);
\end_layout

\begin_layout Plain Layout
plot.show();
\end_layout

\begin_layout Plain Layout
for (int t = 0; t < 500; t++) {
\end_layout

\begin_layout Plain Layout
    step(); // the model
\end_layout

\begin_layout Plain Layout
    plot.clearLayers().add(Plot3D.scatter(x, y, z).values(z)).update();
\end_layout

\begin_layout Plain Layout
    Thread.sleep(50);
\end_layout

\begin_layout Plain Layout
}
\end_layout

\end_inset


\end_layout

