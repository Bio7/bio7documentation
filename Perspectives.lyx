\begin_layout Subsection
Custom Views
\end_layout

\begin_layout Standard
A custom view (class 
\family typewriter
CustomView
\family default
, package 
\family typewriter
com.eco.bio7.collection
\family default
) embeds an own user interface in Bio7: SWT widgets, Draw2d figures, Swing (JPanel) and AWT panels. Several custom views can be created, each view has a unique id (the secondary id of the view) and is displayed in a tab with a title. The content of a custom view can be displayed in the fullscreen mode (F2 the primary monitor, F3 the secondary, F4 the tertiary, F5 a selected monitor, Escape exits).
\end_layout

\begin_layout Standard
\begin_inset Float table
placement H
alignment document
wide false
sideways false
status open

\begin_layout Plain Layout
\begin_inset listings
lstparams "basicstyle={\rmfamily},language=Java,numbers=left"
inline false
status open

\begin_layout Plain Layout
import com.eco.bio7.collection.CustomView;
\end_layout

\begin_layout Plain Layout
import org.eclipse.swt.SWT;
\end_layout

\begin_layout Plain Layout
import org.eclipse.swt.layout.FillLayout;
\end_layout

\begin_layout Plain Layout
import org.eclipse.swt.widgets.*;
\end_layout

\begin_layout Plain Layout

\end_layout

\begin_layout Plain Layout
CustomView view = new CustomView("Control Panel");
\end_layout

\begin_layout Plain Layout
Display.getDefault().syncExec(() -> {
\end_layout

\begin_layout Plain Layout
    Composite parent = view.getComposite("panel1");
\end_layout

\begin_layout Plain Layout
    parent.setLayout(new FillLayout());
\end_layout

\begin_layout Plain Layout
    Button button = new Button(parent, SWT.PUSH);
\end_layout

\begin_layout Plain Layout
    button.setText("Start");
\end_layout

\begin_layout Plain Layout
    parent.layout();
\end_layout

\begin_layout Plain Layout
});
\end_layout

\end_inset


\end_layout

\begin_layout Plain Layout
\begin_inset Caption Standard

\begin_layout Plain Layout
A custom view with an SWT button
\end_layout

\end_inset


\end_layout

\end_inset


\end_layout

\begin_layout Standard
With 
\family typewriter
getDraw2d(id)
\family default
 a Draw2d LightweightSystem is returned (e.g., for the gauges of the Nebula visualization widgets), with 
\family typewriter
setPanel(jpanel, id)
\family default
 a Swing panel is embedded. Further classes extend the custom views:
\end_layout

\begin_layout Itemize

\family typewriter
DetachableCustomView
\family default
: a custom view which is opened as a detached window, optionally on a selected monitor (
\family typewriter
MonitorChooser
\family default
).
\end_layout

\begin_layout Itemize

\family typewriter
DetachedControlPanel
\family default
: a floating control panel (a top-level window) which stays visible in all perspectives, e.g., for the controls of a simulation.
\end_layout

\begin_layout Itemize

\family typewriter
Work.moveViewToPanel(customView, viewId, panel, title)
\family default
: moves a view of Bio7 (e.g., the Console) into a panel of a custom view.
\end_layout

\begin_layout Itemize

\family typewriter
Work.openPerspective(id)
\family default
, 
\family typewriter
Work.closePerspective(idOrName)
\family default
, 
\family typewriter
Work.openView(id)
\family default
 and 
\family typewriter
Work.closeView(id)
\family default
 open and close perspectives and views from a script.
\end_layout

\begin_layout Subsection
The Custom Perspective
\end_layout

\begin_layout Standard
The custom perspective (id 
\family typewriter
