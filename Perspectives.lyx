import bio7
\end_layout

\begin_layout Plain Layout
import numpy as np
\end_layout

\begin_layout Plain Layout
img = bio7.image()                              # the active image
\end_layout

\begin_layout Plain Layout
bio7.show_image(np.sqrt(img.astype(float)), "Square root")
\end_layout

\end_inset


\end_layout


